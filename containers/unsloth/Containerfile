# containers/unsloth/Containerfile  (gegnep/nixos-prod)
#
# Owned Unsloth Studio image, CUDA variant (RTX 3060 / sidecar).
#
# Built by the unsloth-image systemd unit (modules/nixos/services/unsloth.nix):
# tag = localhost/unsloth-studio:<version>-<ctxhash>, rebuilt when version or
# this directory changes. Manual build, for debugging only:
#   sudo podman build -f containers/unsloth/Containerfile \
#     -t localhost/unsloth-studio:<pip version> \
#     -v /var/lib/unsloth/wheels:/wheels:ro \
#     --build-arg UNSLOTH_REF=<git tag> \
#     --build-arg UNSLOTH_PIP_VERSION=<pypi version> containers/unsloth/
#
# Design: install.sh runs at BUILD time at the real runtime path
# (/home/unsloth/.unsloth, a symlink to /opt/unsloth-pristine so venv
# shebangs/pyvenv.cfg stay valid). At runtime the volume shadows
# /home/unsloth/.unsloth; entrypoint.sh syncs code dirs (venv + llama.cpp)
# from the pristine copy on stamp change and never touches state.

FROM docker.io/nvidia/cuda:12.8.1-runtime-ubuntu24.04

ARG UNSLOTH_REF
ARG UNSLOTH_PIP_VERSION
RUN test -n "${UNSLOTH_REF}" && test -n "${UNSLOTH_PIP_VERSION}" \
    || { echo "UNSLOTH_REF and UNSLOTH_PIP_VERSION build-args required"; exit 1; }

# torch wheel leaf; also the /wheels/<family> subdir checked below.
ARG TORCH_INDEX_FAMILY=cu128

# Deps install.sh would otherwise apt-get itself (it runs unprivileged here).
# libgomp1: llama.cpp prebuilts. rsync: entrypoint sync. xz/unzip: prebuilt archives.
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    python3 python3-venv python3-pip python3-dev \
    build-essential \
    git curl ca-certificates \
    rsync xz-utils unzip \
    libgomp1 \
    && rm -rf /var/lib/apt/lists/*

# uid/gid 1001 matches existing /var/lib/unsloth/* volume ownership.
RUN groupadd -g 1001 unsloth && useradd -m -u 1001 -g 1001 -s /bin/bash unsloth

# Build-time nvidia-smi stub. UNSLOTH_LLAMA_CPP_BACKEND=cuda pins the backend,
# but install_llama_prebuilt.py's asset planner still needs driver facts from
# three nvidia-smi invocations (-L, bare banner, --query-gpu=...compute_cap).
# No driver in the build container -> driver_cuda_version=None -> "no runnable
# asset" -> hard fail. The stub answers with the runtime host's real values.
# Removed after install; the runtime container gets the real CDI nvidia-smi.
ARG GPU_NAME="NVIDIA GeForce RTX 3060"
ARG GPU_COMPUTE_CAP="8.6"
ARG DRIVER_CUDA_VERSION="12.8"
RUN printf '%s\n' \
    '#!/bin/sh' \
    "GPU_NAME=\"${GPU_NAME}\"" \
    "CAP=\"${GPU_COMPUTE_CAP}\"" \
    "CUDA=\"${DRIVER_CUDA_VERSION}\"" \
    'case "$1" in' \
    '  -L) echo "GPU 0: $GPU_NAME (UUID: GPU-00000000-0000-0000-0000-000000000000)" ;;' \
    '  --query-gpu=*) echo "0, GPU-00000000-0000-0000-0000-000000000000, $CAP" ;;' \
    '  *) echo "NVIDIA-SMI stub    Driver Version: build    CUDA Version: $CUDA" ;;' \
    'esac' \
    > /usr/local/bin/nvidia-smi && chmod 0755 /usr/local/bin/nvidia-smi

# Install at the real runtime path via symlink so venv shebangs/pyvenv.cfg
# resolve to /home/unsloth/.unsloth, while the bytes land in
# /opt/unsloth-pristine (no mv -> no duplicated layer, no chown -R).
RUN mkdir -p /opt/unsloth-pristine && chown 1001:1001 /opt/unsloth-pristine \
    && ln -s /opt/unsloth-pristine /home/unsloth/.unsloth

USER unsloth
WORKDIR /home/unsloth

# Build-time env:
#   UNSLOTH_TORCH_INDEX_FAMILY=cu128   -> cu128 torch wheels, skips GPU probe
#   UNSLOTH_LLAMA_CPP_BACKEND=cuda     -> pin llama.cpp backend (no fallback)
#   UNSLOTH_SKIP_AUTOSTART=1           -> install.sh must not launch studio
#
# RELEASE mode (no --local): installs the published wheel (backend + prebuilt
# frontend included), self-contained under ~/.unsloth. --local does an
# EDITABLE install with venv refs into the checkout, severed by the rm -rf.
# The clone exists only to pin install.sh itself to a known ref.
#
# Version pin: --package rejects version specs, so the pin rides in via uv's
# UV_CONSTRAINT env, honored by every `uv pip install` the installer runs.
#
# /wheels is bind-mounted by the unsloth-image unit (host /var/lib/unsloth/wheels).
# When /wheels/<family> holds torch wheels, expose it as a flat index ABOVE the
# CDN default index: uv's first-index strategy resolves torch* locally and only
# fetches the small deps from download.pytorch.org. Empty/absent -> CDN.
# uv cache persists across builds via the cache mount (not in the image).
RUN --mount=type=cache,target=/home/unsloth/.cache/uv,uid=1001,gid=1001 \
    git clone --depth 1 --branch "${UNSLOTH_REF}" https://github.com/unslothai/unsloth.git /home/unsloth/src \
    && printf 'unsloth==%s\n' "${UNSLOTH_PIP_VERSION}" > /home/unsloth/constraints.txt \
    && cd /home/unsloth/src \
    && if ls /wheels/"${TORCH_INDEX_FAMILY}"/torch-*.whl >/dev/null 2>&1; then export UV_INDEX=/wheels/"${TORCH_INDEX_FAMILY}"; fi \
    && echo "[build] torch flat index: ${UV_INDEX:-<none, CDN>}" \
    && UNSLOTH_TORCH_INDEX_FAMILY="${TORCH_INDEX_FAMILY}" \
       UNSLOTH_LLAMA_CPP_BACKEND=cuda \
       UNSLOTH_SKIP_AUTOSTART=1 \
       UV_HTTP_TIMEOUT=900 \
       UV_CONSTRAINT=/home/unsloth/constraints.txt \
       ./install.sh \
    && rm -rf /home/unsloth/src /home/unsloth/constraints.txt /home/unsloth/.cache/pip

# Drop the symlink so the runtime volume mounts on a clean path; stamp pristine.
USER root
RUN rm /usr/local/bin/nvidia-smi /home/unsloth/.unsloth \
    && printf '%s_%s\n' "${UNSLOTH_REF}" "${UNSLOTH_PIP_VERSION}" > /opt/unsloth-pristine/.image-stamp

COPY --chmod=0755 entrypoint.sh /usr/local/bin/entrypoint.sh

USER unsloth
WORKDIR /workspace/work

# All caches (HF included) into the persistent /workspace/.cache volume.
ENV XDG_CACHE_HOME=/workspace/.cache \
    HF_HOME=/workspace/.cache/huggingface

EXPOSE 8000
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
